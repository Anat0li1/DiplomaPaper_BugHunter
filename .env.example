# BugHunter Environment Variables
# Copy this file to .env and update with your actual values

# =============================================================================
# Flask Application Configuration
# =============================================================================

# Flask secret key for session management and CSRF protection
# Generate a strong random key for production (e.g., use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev-secret-key-change-in-production

# JWT secret key for token signing
# Generate a strong random key for production (e.g., use: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Flask environment: 'development' or 'production'
# In production, set to 'production' for better security and performance
FLASK_ENV=development

# Flask application name (optional)
FLASK_APP=app.py

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL database connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bughunter

# For Docker Compose (when running in containers):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/bughunter

# Alternative: Individual database connection parameters (if not using DATABASE_URL)
# These are used by docker-compose.yml for the PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bughunter
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# Server Configuration
# =============================================================================

# Flask server host (0.0.0.0 to accept connections from all interfaces)
FLASK_HOST=0.0.0.0

# Flask server port
FLASK_PORT=5000

# =============================================================================
# AI Helper Configuration (Optional)
# =============================================================================

# OpenAI API Key (if using OpenAI for AI Helper)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (if using Claude for AI Helper)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AI Provider: 'openai', 'anthropic', or 'mock' (for testing)
# AI_PROVIDER=mock

# ------------------
# Azure AI / RAG settings (for Azure OpenAI + Cognitive Search)
# ------------------
# Azure OpenAI endpoint and key
# Example endpoint: https://my-openai-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# Azure Cognitive Search endpoint and admin key
# Example endpoint: https://my-search-service.search.windows.net
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=rag-index

# =============================================================================
# Security Configuration
# =============================================================================

# JWT token expiration (in seconds)
# Set to False for no expiration (not recommended for production)
# JWT_ACCESS_TOKEN_EXPIRES=False

# CORS allowed origins (comma-separated)
# For production, specify your actual domain
# CORS_ORIGINS=http://localhost:5000,http://localhost:80

# =============================================================================
# Development/Testing
# =============================================================================

# Enable debug mode (set to False in production)
DEBUG=True

# Enable SQL query logging
SQLALCHEMY_ECHO=False

# =============================================================================
# Production Deployment
# =============================================================================

# For production, ensure:
# - SECRET_KEY is a strong random string
# - JWT_SECRET_KEY is a strong random string
# - FLASK_ENV=production
# - DEBUG=False
# - Use secure database credentials
# - Configure proper CORS_ORIGINS
# - Use environment-specific DATABASE_URL

# Example production values:
# SECRET_KEY=your-very-long-random-secret-key-here-minimum-32-characters
# JWT_SECRET_KEY=your-very-long-random-jwt-secret-key-here-minimum-32-characters
# FLASK_ENV=production
# DEBUG=False
# DATABASE_URL=postgresql://user:password@production-db-host:5432/bughunter
