# Змінні середовища Порталу якості
# Скопіюйте цей файл у .env і заповніть реальні значення.

SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production
FLASK_ENV=development
FLASK_APP=app.py
DEBUG=True

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quality_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quality_portal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Асистент і RAG, якщо потрібна реальна інтеграція.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=quality-portal-index
RAG_MAX_CONTEXT_CHARS=2000
RAG_TOP_K=5
RAG_SYSTEM_PROMPT=Ви корисний асистент. Використовуйте наданий контекст для відповіді користувачу. Якщо відповіді немає в контексті, скажіть, що не знаєте.

# Production-підказки:
# - задайте сильні SECRET_KEY та JWT_SECRET_KEY
# - FLASK_ENV=production
# - DEBUG=False
# - DATABASE_URL має вказувати на production-базу
